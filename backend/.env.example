# Konfigurasi Backend SiagaGunung
APP_NAME="SiagaGunung API"
APP_VERSION="1.0.0"
DEBUG=false

# Sumber MAGMA Indonesia
MAGMA_BASE_URL="https://magma.esdm.go.id"
SOURCE_TIMEOUT_SECONDS=10
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=2.0

# Pengaturan Cache & Refresh
LIST_REFRESH_INTERVAL_MINUTES=30
DETAIL_CACHE_TTL_MINUTES=60
STALE_THRESHOLD_MINUTES=120

# Proteksi Anomali Penurunan Data
COUNT_DROP_THRESHOLD_PCT=0.20

# CORS (pisahkan koma untuk multiple origin)
ALLOWED_ORIGINS=["*"]
